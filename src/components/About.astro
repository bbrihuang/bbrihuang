---
import { coursework } from "../data/education.js";
---

<section id="about" class="bb-section" aria-labelledby="about-title">
    <h2 id="about-title" class="bb-section-word">About</h2>
    <div class="bb-cols">
        <div class="about-main bb-span-7">
            <div class="shot"><img src="/avatar.jpg" alt="Brian Huang" width="128" height="128"></div>
            <p class="bb-statement">I’m a sophomore in computer engineering at Boston University. I build where software meets hardware: robots, a rocket nozzle, a home server that runs its own AI models.</p>
        </div>
        <div class="edu bb-span-5">
            <div class="edu-head">
                <img src="/logos/bu-wordmark.png" alt="Boston University" width="125" height="56">
                <div>
                    <p class="edu-degree">B.S. Computer Engineering</p>
                    <p class="muted">Boston University, class of 2029</p>
                </div>
            </div>
            <dl class="courses">
                {coursework.map((group) => (
                    <div>
                        <dt>{group.group}</dt>
                        <dd>
                            <ul>
                                {group.courses.map((course) => <li class:list={{ now: course.inProgress }}>{course.name}</li>)}
                            </ul>
                        </dd>
                    </div>
                ))}
            </dl>
            <p class="muted now-key">Taking this semester</p>
            <p class="edu-links">
                <a class="bb-link" href="https://github.com/bbrihuang">GitHub</a>
                <a class="bb-link" href="https://www.linkedin.com/in/bbrihuang/">LinkedIn</a>
                <a class="bb-link" href="mailto:bbhuang@bu.edu">Email</a>
                <a class="bb-link" href="/Brian_Huang_Resume.pdf">Résumé</a>
            </p>
        </div>
    </div>
</section>
