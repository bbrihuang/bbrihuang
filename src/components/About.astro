---
import { clubs } from "../data/clubs.js";
---

<section id="about">
    <h2 class="section-title">About Me</h2>
    <p>Hi! I am Brian. I am a Computer Engineering student at Boston University. I do local LLM and robotics work with BU AI Society, lead software at GradientV for small businesses, and run Cubic Builds, my custom PC building business.</p>
    <p>I'm interested in engineering at the intersection of software and hardware, particularly robotics, embedded systems, and AI inference. I really love work that brings code into the physical world, whether that's controlling devices, optimizing performance, or deploying intelligent systems on real hardware.</p>

    <h3 class="about-heading">Education</h3>
    <div class="education">
        <img src="/logos/bu.png" alt="" width="36" height="36">
        <div>
            <p class="education-degree">B.S. Computer Engineering</p>
            <p class="education-school">Boston University | Expected May 2029</p>
        </div>
    </div>

    <h3 class="about-heading">Clubs & activities</h3>
    <ul class="clubs">
        {clubs.map((club) => (
            <li>
                <a href={club.href} target="_blank" rel="noopener noreferrer">
                    {club.logo
                        ? <img src={club.logo} alt="" width="44" height="44" loading="lazy">
                        : <span class="club-initials" aria-hidden="true">{club.initials}</span>}
                    <span class="club-text">
                        <span class="club-name">{club.org}</span>
                        <span class="club-role" title={club.role}>{club.role}</span>
                    </span>
                    <span class="club-arrow" aria-hidden="true">&nearr;</span>
                </a>
            </li>
        ))}
    </ul>
</section>
