---
import { stack } from "../data/stack.js";
import { markOf, slugOf } from "../data/skills.js";
---

<section id="skills" class="bb-section" aria-labelledby="skills-title">
    <h2 id="skills-title" class="bb-section-word">Skills</h2>
    <dl class="skills">
        {stack.map((group) => (
            <div>
                <dt>{group.group}</dt>
                <dd>
                    <ul>
                        {group.items.map((item) => {
                            const mark = markOf(item);
                            return (
                                <li>
                                    <svg class:list={{ glyph: !mark.filled }} viewBox="0 0 24 24" width="22" height="22" style={`color: ${mark.color}`} aria-hidden="true" set:html={mark.svg} />
                                    <span>{item.name}</span>
                                    {item.certs?.length > 0 && (
                                        <a class="certified" href={`/certifications/${slugOf(item.name)}/`} aria-label={`${item.name} certificates`}>Certified</a>
                                    )}
                                </li>
                            );
                        })}
                    </ul>
                </dd>
            </div>
        ))}
    </dl>
</section>
