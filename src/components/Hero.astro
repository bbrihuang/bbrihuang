---
import Bill from "./Bill.astro";

// Each letter is its own span, so the builder can fill the name a word at a time
// (see setUpBuilder in main.js and the hero builder in global.css).
const name = "Brian Huang";
---

<section class="hero" aria-label="Introduction">
    <div class="fit">
        <h1 class="bb-name" aria-label={name}>
            {[...name].map((letter, index) => (letter === " " ? " " : <span class="letter" aria-hidden="true" style={`--i: ${index}`}>{letter}</span>))}
        </h1>
    </div>
    <div class="fit ground">
        <hr class="bb-grad-rule">
        <!-- Bill Durr builds the name, then assembles a portal to his elevator. -->
        <span class="builder" data-pose="stand"><Bill /></span>
        <span class="builder-portal" aria-hidden="true" hidden></span>
    </div>
</section>
