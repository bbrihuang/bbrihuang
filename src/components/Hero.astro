---
// Each letter is its own span, so the robot can build the name letter by letter
// as it walks under it (see the hero motion in global.css and setUpBuilder in main.js).
const name = "Brian Huang";
---

<section class="hero" aria-label="Introduction">
    <div class="fit">
        <h1 class="bb-name" aria-label={name}>
            {[...name].map((letter, index) => (letter === " " ? " " : <span class="letter" aria-hidden="true" style={`--i: ${index}`}>{letter}</span>))}
        </h1>
    </div>
    <div class="fit ground">
        <hr class="bb-grad-rule">
        <!-- A side view of a hexapod: near legs in ink, far legs muted; legs a and b alternate. -->
        <button class="builder" type="button" aria-label="Build the name again">
            <svg viewBox="0 0 86 44" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <g class="far">
                    <path class="leg b" style="transform-origin: 22px 20px" d="M22 20 L14 12 L8 40" />
                    <path class="leg a" style="transform-origin: 43px 20px" d="M43 20 L43 10 L43 40" />
                    <path class="leg b" style="transform-origin: 64px 20px" d="M64 20 L72 12 L78 40" />
                </g>
                <g class="chassis">
                    <rect x="16" y="15" width="54" height="11" rx="3" fill="var(--bb-paper)" />
                    <path d="M43 15 V8 M37 8 H49" />
                    <circle cx="66" cy="20.5" r="1.6" fill="currentColor" stroke="none" />
                </g>
                <g>
                    <path class="leg a" style="transform-origin: 24px 22px" d="M24 22 L15 14 L10 41" />
                    <path class="leg b" style="transform-origin: 43px 22px" d="M43 22 L43 12 L43 41" />
                    <path class="leg a" style="transform-origin: 62px 22px" d="M62 22 L71 14 L76 41" />
                </g>
            </svg>
        </button>
    </div>
</section>
