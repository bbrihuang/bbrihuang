---
// With a case study, the whole card (picture included) opens it: the title
// link stretches over the card.
const { project } = Astro.props;
---

<article class:list={["project-card", { featured: project.featured, linked: project.slug }]}>
    <div class="shot">
        {project.cover && <img src={project.cover} alt={project.coverAlt} loading={project.featured ? "eager" : "lazy"}>}
    </div>
    <div class="project-body">
        <p class="project-meta bb-meta"><span>{project.tag}</span>{project.year && <span>{project.year}</span>}</p>
        <h3>
            {project.slug
                ? <a class="project-link" href={`/projects/${project.slug}/`}>{project.title}</a>
                : project.title}
        </h3>
        <p class="muted">{project.description}</p>
        {project.chips.length > 0 && (
            <ul class="tags">
                {project.chips.slice(0, 4).map((chip) => <li>{chip}</li>)}
            </ul>
        )}
    </div>
</article>
