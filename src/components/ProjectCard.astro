---
// With a case study, the whole card (thumbnail included) opens it: the title
// link stretches over the card, and the GitHub link sits above it.
const { project } = Astro.props;
---

<article class:list={["project-card", { featured: project.featured, placeholder: project.placeholder, linked: project.slug }]}>
    <div class="project-cover">
        {project.featured && <span class="badge-featured"><span aria-hidden="true">&#9733;</span> Featured</span>}
        {project.cover && <img src={project.cover} alt={project.coverAlt} loading="lazy">}
    </div>
    <div class="project-body">
        <p class="project-tag">{project.tag}</p>
        <h3>
            {project.slug
                ? <a class="project-link" href={`/projects/${project.slug}/`}>{project.title}</a>
                : project.title}
        </h3>
        <p>{project.description}</p>
        {project.chips.length > 0 && (
            <ul class="chips">
                {project.chips.map((chip) => (
                    <li>{chip}</li>
                ))}
            </ul>
        )}
        <p class="project-meta">{project.year}</p>
        {project.github && (
            <div class="project-links">
                <a href={project.github} target="_blank" rel="noopener noreferrer">GitHub</a>
            </div>
        )}
    </div>
</article>
