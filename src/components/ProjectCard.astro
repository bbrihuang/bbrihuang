---
const { project } = Astro.props;
---

<article class:list={["project-card", { featured: project.featured, placeholder: project.placeholder }]}>
    <p class="project-tag">{project.tag}</p>
    <h3>{project.title}</h3>
    <p>{project.description}</p>
    {project.chips.length > 0 && (
        <ul class="chips">
            {project.chips.map((chip) => (
                <li>{chip}</li>
            ))}
        </ul>
    )}
    <p class="project-meta">{project.status}</p>
    {project.github && (
        <div class="project-links">
            {project.slug && <a href={`/projects/${project.slug}/`}>View case study</a>}
            <a href={project.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
    )}
</article>
