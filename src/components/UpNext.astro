---
// Card at the end of a page that leads to the next one.
const { title, href, color } = Astro.props;
---

<a class="up-next" href={href} style={`--next-color: ${color}`}>
    <span>
        <span class="up-next-label">Up next</span>
        <span class="up-next-title">{title}</span>
    </span>
    <span class="up-next-arrow" aria-hidden="true">&rarr;</span>
</a>
