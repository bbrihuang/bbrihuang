---
// Small pill pinned to the bottom corner that leads to the next page. It
// stays in view while scrolling.
const { title, href, color } = Astro.props;
---

<a class="up-next" href={href} style={`--next-color: ${color}`} aria-label={`Up next: ${title}`}>
    <span class="up-next-label" aria-hidden="true">Up next</span>
    <span class="up-next-title" aria-hidden="true">{title}</span>
    <span class="up-next-arrow" aria-hidden="true">&rarr;</span>
</a>
