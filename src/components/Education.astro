---
import { coursework } from "../data/education.js";
---

<section id="education">
    <h2 class="section-title">Education</h2>
    <div class="education">
        <img src="/logos/bu-wordmark.png" alt="Boston University" width="500" height="224" loading="lazy">
        <div>
            <h3>B.S. Computer Engineering</h3>
            <p>Boston, MA · Expected May 2029</p>
        </div>
    </div>
    <h3 class="coursework-title">Relevant coursework</h3>
    <dl class="coursework">
        {coursework.map((group) => (
            <div class="course-group">
                <dt>{group.group}</dt>
                <dd>
                    <ul class="course-list">
                        {group.courses.map((course) => (
                            <li>
                                <span class="course-name">{course.name}</span>
                                <span class="course-meta">
                                    {course.code}
                                    {course.inProgress && <span class="course-status">In progress</span>}
                                </span>
                            </li>
                        ))}
                    </ul>
                </dd>
            </div>
        ))}
    </dl>
</section>
