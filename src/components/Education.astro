---
import { coursework } from "../data/education.js";
---

<section id="education">
    <h2 class="section-title">Education</h2>
    <div class="education">
        <h3><img src="/logos/bu-wordmark.png" alt="Boston University" width="500" height="224" loading="lazy"></h3>
        <p>B.S. Computer Engineering · Boston, MA</p>
        <p class="education-when">Class of 2029 · Expected May 2029</p>
    </div>
    <p class="rail-label coursework-title">Relevant coursework</p>
    <dl class="stack coursework">
        {coursework.map((group) => (
            <div class="stack-group">
                <dt>{group.group}</dt>
                <dd>
                    <ul class="chips">
                        {group.courses.map((course) => (
                            <li>
                                {course.name}
                                <span class="course-code">{course.code}</span>
                                {course.inProgress && <span class="course-status">In progress</span>}
                            </li>
                        ))}
                    </ul>
                </dd>
            </div>
        ))}
    </dl>
</section>
