---
// Bill Durr's elevator: home sections are upstairs and the dedicated pages are in the basement.
import Bill from "./Bill.astro";

const path = Astro.url.pathname;
const floors = [
    { id: "top", label: "Lobby", href: path === "/" ? "#" : "/" },
    { id: "about", label: "About", href: "/#about" },
    { id: "projects", label: "Projects", href: "/#projects" },
    { id: "experience", label: "Experience", href: "/#experience" },
    { id: "skills", label: "Skills", href: "/#skills" },
];
const pages = [
    { label: "All projects", href: "/projects/" },
    { label: "Activities", href: "/involvement/" },
];
const basement = pages.findIndex((page) => path.startsWith(page.href) || path === page.href.slice(0, -1));
const level = basement < 0 ? (path.startsWith("/certifications/") ? floors.length - 1 : 0) : floors.length + basement;
---

<nav class="elevator" aria-label="Site" style={`--floors: ${floors.length}; --at: ${level}`} data-basement={basement >= 0 ? "" : undefined}>
    <div class="shaft" aria-hidden="true">
        {[...floors, ...pages].map((floor, index) => <span class="floor-mark" style={`--i: ${index}`}></span>)}
    </div>
    <div class="basement" aria-hidden="true"></div>
    <button class="car" type="button" aria-expanded="false" aria-controls="where-to" data-pose="stand">
        <span class="sr-only">Where to? Open Bill Durr's elevator</span>
        <Bill />
    </button>
    <p class="elevator-tip" role="status" hidden>Click the orange corner at the top right of the page to switch themes!</p>
    <div class="where-to" id="where-to" hidden>
        <p class="where-title">Where to?</p>
        <ul>
            {floors.map((floor, index) => (
                <li><a href={floor.href} data-floor={index} data-section={floor.id}>{floor.label}</a></li>
            ))}
        </ul>
        <p class="where-basement" id="where-basement">Basement</p>
        <ul class="where-pages" aria-labelledby="where-basement">
            {pages.map((page, index) => (
                <li><a href={page.href} data-floor={floors.length + index} aria-current={index === basement ? "location" : undefined}>{page.label}</a></li>
            ))}
        </ul>
        <p class="where-sign">Operated by Bill Durr</p>
    </div>
    {path === "/" && (
        <script is:inline>
            if (location.hash) {
                const elevator = document.currentScript.parentElement;
                const stop = [...elevator.querySelectorAll("a[data-section]")].find((link) => location.hash === `#${link.dataset.section}`);
                if (stop) elevator.style.setProperty("--at", stop.dataset.floor);
            }
        </script>
    )}
</nav>
