---
import { clubs } from "../data/clubs.js";
import { projects } from "../data/projects.js";

// Each club's `projects` are slugs from projects.js, shown as links on its card.
const cards = clubs.map((club) => ({
    ...club,
    related: (club.projects ?? [])
        .map((slug) => projects.find((project) => project.slug === slug))
        .filter(Boolean),
}));
---

<section id="involvement">
    <h2 class="section-title">Involvement</h2>
    <ul class="clubs">
        {cards.map((club) => (
            <li class:list={["club-card", { linked: club.description }]}>
                {club.gallery?.length > 0 && (
                    <div class="club-cover">
                        {club.gallery.map((photo, index) => (
                            <img class:list={["club-photo", { "is-active": index === 0 }]} src={photo.src} alt={photo.alt} loading="lazy">
                        ))}
                    </div>
                )}
                <div class="club-body">
                    <div class="club-top">
                        <div class="club-text">
                            {club.description
                                ? <a class="club-link" href={`/involvement/${club.slug}/`}>
                                    <span class="club-name">{club.org}</span>
                                    <span class="club-arrow" aria-hidden="true">&rarr;</span>
                                </a>
                                : club.href
                                ? <a class="club-link" href={club.href} target="_blank" rel="noopener noreferrer">
                                    <span class="club-name">{club.org}</span>
                                    <span class="club-arrow" aria-hidden="true">&nearr;</span>
                                </a>
                                : <span class="club-name">{club.org}</span>}
                            <p class="club-role">{club.role}</p>
                        </div>
                        {club.logo
                            ? <img class="club-logo" src={club.logo} alt="" width="52" height="52" loading="lazy">
                            : <span class="club-logo club-initials" aria-hidden="true">{club.initials}</span>}
                    </div>
                    {club.related.length > 0 && (
                        <ul class="club-related" aria-label="Related projects">
                            {club.related.map((project) => (
                                <li><a href={`/projects/${project.slug}/`}>{project.title}</a></li>
                            ))}
                        </ul>
                    )}
                </div>
            </li>
        ))}
    </ul>
</section>
