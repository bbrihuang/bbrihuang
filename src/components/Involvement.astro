---
import { clubs } from "../data/clubs.js";
import { projects } from "../data/projects.js";

// Each club's `projects` are slugs from projects.js, shown as links on its card.
const cards = clubs.map((club) => ({
    ...club,
    related: (club.projects ?? [])
        .map((slug) => projects.find((project) => project.slug === slug))
        .filter(Boolean),
}));
// Clubs with photos get cards; the rest sit in one ruled list.
const featured = cards.filter((club) => club.gallery?.length > 0);
const others = cards.filter((club) => !club.gallery?.length);
const linkOf = (club) => (club.description ? `/involvement/${club.slug}/` : club.href);
---

<section id="activities" class="activities">
    <ul class="club-cards">
        {featured.map((club) => (
            <li class="club-card">
                <a class="club-head" href={linkOf(club)}>
                    <span class="logo"><img src={club.logo} alt="" width="32" height="32" loading="lazy"></span>
                    <span class="club-text"><span class="club-name">{club.org}</span><span class="muted">{club.role}</span></span>
                    <span class="bb-arrow" aria-hidden="true">↗</span>
                </a>
                <div class="club-photos">
                    {club.gallery.map((photo) => (
                        <div class="shot"><img src={photo.src} alt={photo.alt} loading="lazy"></div>
                    ))}
                </div>
                {club.related.length > 0 && (
                    <p class="club-related">
                        {club.related.map((project) => <a class="bb-link" href={`/projects/${project.slug}/`}>{project.title}</a>)}
                    </p>
                )}
            </li>
        ))}
    </ul>
    <ul class="club-list">
        {others.map((club) => {
            const inner = (
                <>
                    {club.logo
                        ? <span class="logo"><img src={club.logo} alt="" width="32" height="32" loading="lazy"></span>
                        : <span class="logo logo-initials" aria-hidden="true">{club.initials}</span>}
                    <span class="club-text"><span class="club-name">{club.org}</span><span class="muted">{club.role}</span></span>
                </>
            );
            return (
                <li>
                    {club.href
                        ? <a class="club-row" href={club.href}>{inner}<span class="bb-arrow" aria-hidden="true">↗</span></a>
                        : <div class="club-row">{inner}</div>}
                </li>
            );
        })}
    </ul>
</section>
