---
// Home sections are anchors; Projects is its own page. `section` lets the top bar
// follow the scroll on Home (see setUpSectionSpy in main.js).
const links = [
    { href: "/#about", label: "About", section: "about" },
    { href: "/projects/", label: "Projects", section: "projects" },
    { href: "/#experience", label: "Experience", section: "experience" },
    { href: "/#activities", label: "Activities", section: "activities" },
    { href: "/#skills", label: "Skills", section: "skills" },
    { href: "/Brian_Huang_Resume.pdf", label: "Résumé" },
];

const path = Astro.url.pathname;
// Off Home, Projects is marked on the projects pages and Activities on the club pages.
const isCurrent = (link) =>
    (link.label === "Projects" && path.startsWith("/projects/")) ||
    (link.label === "Activities" && path.startsWith("/involvement/"));
---

<header class="site-header">
    <a class="brand" href="/">
        <img class="bb-only-light" src="/brand/mark.svg" width="28" height="28" alt="">
        <img class="bb-only-dark" src="/brand/mark-inverse.svg" width="28" height="28" alt="">bbrihuang
    </a>
    <nav class="bb-nav site-nav" aria-label="Primary">
        {links.map((link) => (
            <a href={link.href} data-section={link.section} aria-current={isCurrent(link) ? "page" : undefined}>{link.label}</a>
        ))}
    </nav>
</header>
