---
// Big page title in the section's color, with a short intro under it.
const { title, lede, color } = Astro.props;
---

<header class="page-header" style={`--page-color: ${color}`}>
    <div class="page-header-text">
        <h1>{title}</h1>
        {lede && <p>{lede}</p>}
    </div>
    <slot />
</header>
