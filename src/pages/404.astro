---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import PageHeader from "../components/PageHeader.astro";
---

<Layout title="Page not found | Brian Huang" description="This page doesn’t exist on Brian Huang’s portfolio.">
    <Nav />
    <main id="main" style="min-height: 75vh">
        <PageHeader title="Page not found" lede="This page doesn’t exist or has moved." />
        <p class="not-found-actions">
            <a class="bb-btn" href="/">Back to home <span class="bb-btn-arrow" aria-hidden="true">→</span></a>
            <a class="bb-link" href="/projects/">View projects</a>
        </p>
    </main>
</Layout>
