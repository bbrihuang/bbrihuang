---
import Layout from "./Layout.astro";
import Nav from "../components/Nav.astro";

const { frontmatter } = Astro.props;
const links = [
    ...(frontmatter.github ? [{ label: "GitHub", href: frontmatter.github }] : []),
    ...(frontmatter.links ?? []),
];
---

<Layout title={`${frontmatter.title} | Brian Huang`} description={frontmatter.description}>
    <Nav />
    <main id="main" class="case-study">
        <header class="case-header">
            <a class="back-link" href="/projects/">&larr; All projects</a>
            <p class="project-tag">{frontmatter.tag}</p>
            <h1>{frontmatter.title}</h1>
            <p class="case-lede">{frontmatter.description}</p>
            <p class="project-meta">{frontmatter.year}</p>
            <ul class="chips">
                {frontmatter.chips.map((chip) => (
                    <li>{chip}</li>
                ))}
            </ul>
            {links.length > 0 && (
                <p class="case-links">
                    {links.map((link) => (
                        <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
                    ))}
                </p>
            )}
        </header>
        <article class="case-body">
            <slot />
        </article>
    </main>
</Layout>
