---
import "../styles/tokens.css";
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import Footer from "../components/Footer.astro";

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL("/og.png", Astro.site);
// Search results cut off around 160 characters, so long summaries use their first sentence.
const summary = description.length > 160 ? description.split(/(?<=\.)\s/)[0] : description;
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={summary}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={summary}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={image}>
    <meta name="twitter:card" content="summary_large_image">
    <link rel="canonical" href={canonical}>
    <meta property="og:type" content="website">
    <meta name="theme-color" content="#ECEAE4" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0E0E0F" media="(prefers-color-scheme: dark)">
    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="icon" type="image/svg+xml" href="/icon.svg">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,500..800&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <title>{title}</title>
    <!-- Before the first paint: apply a saved theme, so the page never flashes the other one,
         and hold blocks in their starting pose so their entrances play (see setUpReveal in
         main.js). If the main script never runs, everything shows after 3 seconds. -->
    <script is:inline>
        document.documentElement.classList.add("js-reveal");
        setTimeout(function () {
            if (!window.__revealReady) document.documentElement.classList.remove("js-reveal");
        }, 3000);
        // The season for the background: a saved pick, or today's (northern hemisphere).
        var month = new Date().getMonth();
        var season = ["winter", "winter", "spring", "spring", "spring", "summer", "summer", "summer", "fall", "fall", "fall", "winter"][month];
        try {
            var theme = localStorage.getItem("theme");
            if (theme) document.documentElement.dataset.theme = theme;
            season = localStorage.getItem("season") || season;
        } catch (e) {}
        document.documentElement.dataset.season = season;
    </script>
</head>

<body>
    <a class="skip-link" href="#main">Skip to content</a>
    <!-- The brand corner, which also switches light and dark. -->
    <button class="corner" type="button" aria-label="Switch theme"></button>

    <div class="bb-page">
        <slot />
        <Footer />
    </div>

    <!-- In the body because a custom element in the head ends the head early. -->
    <Analytics />

    <script>
        import "../scripts/main.js";
    </script>
</body>
</html>
